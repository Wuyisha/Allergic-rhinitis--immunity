peakDF <- as.data.frame(peakSet) %>%
  dplyr::select(
    seqnames,
    start,
    end,
    nearestGene,
    peakType,
    distToTSS
  ) %>%
  mutate(
    region = paste0(seqnames, ":", start, "-", end)
  )

write.csv(peakDF, "Macro_CCL3_peakSet.csv", row.names = FALSE)

# ---------------------------------------------------------
# 2. Load Differential Peak Results
# ---------------------------------------------------------
dap <- readRDS("PARker_features_dx.rds")

cutoff <- "FDR < 0.1 & abs(Log2FC) > 0.25"

# SAR vs NAR
se_sar <- dap[[1]]
colnames(se_sar) <- "SAR"

# PAR vs NAR
se_PAR <- dap[[2]]
colnames(se_PAR) <- "PAR"

# Combine
se_dap <- cbind(se_sar, se_PAR)

# ---------------------------------------------------------
# 3. Convert GRanges → DataFrame
# ---------------------------------------------------------
dar_sar <- as.data.frame(getPARkers(se_sar, cutOff = cutoff, returnGR = TRUE))
dar_PAR <- as.data.frame(getPARkers(se_PAR, cutOff = cutoff, returnGR = TRUE))

dar_all <- bind_rows(
  dar_sar,
  dar_PAR
) %>%
  mutate(
    region = paste0(seqnames, ":", start, "-", end)
  )

write.csv(dar_sar, "dap_Macro_CCL3_SAR_filter.csv", row.names = FALSE)
write.csv(dar_PAR, "dap_Macro_CCL3_PAR_filter.csv", row.names = FALSE)

# ---------------------------------------------------------

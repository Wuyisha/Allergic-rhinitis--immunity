library(CellChat)
library(patchwork)
library(Seurat)
library(purrr)   # Load once
library(ggpubr)  
library(cowplot)
library(dplyr)   # Bring dplyr along for the ride
options(stringsAsFactors = FALSE)

setwd(“/media/AnalysisTempDisk2/Wuyisha/HNM_IMMUNE/RNA/cellchat”)

cellchat_NAR <- readRDS(“scRNA_NAR_cellchat_Net.rds”)
cellchat_SAR <- readRDS(“scRNA_SAR_cellchat_Net.rds”)
cellchat_MAR <- readRDS(“scRNA_MAR_cellchat_Net.rds”)


cellchat_list <- c(cellchat_NAR, cellchat_SAR, cellchat_MAR)
names(cellchat_list) <- c(“NAR”, ‘SAR’, ‘MAR’)
uterus_cellchat <- mergeCellChat(cellchat_list, add.names = names(cellchat_list))




############ Myeloid cell related plot#######################
################Antigen presentation ################
pathways.want <- c(‘MHC-II’, “CD86”,
                  )   #“ANNEXIN”,

## 2. Extract all L-R pairs for each pathway sequentially, adding a column to tag the pathway
lr_all <- map_dfr(pathways.want,
                  ~ extractEnrichedLR(uterus_cellchat,
                                      signaling = .x,
                                      geneLR.return = FALSE) %>%
                    mutate(Pathway = .x))

## 3. Plot the overall bubble diagram in one go
p_joint <- netVisual_bubble(uterus_cellchat,
                            pairLR.use   = lr_all,
                            # remove.isolate = TRUE,
                             targets.use =c(‘CD4_Trm’,“CD4_Th1”,‘CD8_Trm’),                  
                   sources.use= c(‘Macro_CCL3’,“CD14_Mo”), 
                            angle.x = 90,
                            comparison = c(1,2,3) , dot.size.min = 1, dot.size.max = 4,
                 colour.text = c(‘#a8a9cb’, ‘#f3b669’, ‘#f08c3c’))

p_joint
## 4. Save
ggsave(‘./Fig/myeloid/multi_pathway_all_LRpairs_bubble_macro_CCL3_agence.pdf’, p_joint, width = 6, height = 4.5)






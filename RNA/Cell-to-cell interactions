data <- readRDS('/media/AnalysisTempDisk2/Wuyisha/HNM_IMMUNE/RNA/data/HNM_23samples_data_4_immune_cells_1.rds')
Cells.sub <- subset(data@meta.data, group_A!="PAR")
data_a <- subset(data, cells=row.names(Cells.sub))
table(data_a$group_A)
data_a



NAR
Cells.sub <- subset(data_a@meta.data, group_A==‘NAR’)
seurat_object_nar <- subset(data_a, cells=row.names(Cells.sub))
seurat_object_nar
Idents(seurat_object_nar) <- seurat_object_nar$subtype

# Data preparation
data.input <- seurat_object_nar[[‘RNA’]]@data # normalised data matrix
# For Seurat version >= ‘5.0.0’, obtain normalised data via `seurat_object[[‘RNA’]]$data`
labels <- Idents(seurat_object_nar)
table(Idents(seurat_object_nar))
meta <-seurat_object_nar@meta.data


### Create cellchat
cellchat <- createCellChat(object = seurat_object_nar, group.by = ‘ident’, assay = ‘RNA’)
# Add information
cellchat <- addMeta(cellchat, meta = meta)
# cellchat <- setIdent(cellchat, ident.use = ‘labels’) # set ‘labels’ as default cell identity
levels(cellchat@idents) # display factor levels of cell labels
groupSize <- as.numeric(table(cellchat@idents)) # count of cells per group


## Set ligand-receptor interaction database
CellChatDB <- CellChatDB.human # use CellChatDB.mouse if running on mouse data
showDatabaseCategory(CellChatDB)
# Display database structure
dplyr::glimpse(CellChatDB$interaction)
#3233

# Select the entire database
CellChatDB.use <- CellChatDB
# CellChatDB.use <- subsetDB(CellChatDB, search = ‘Secreted Signaling’)
# CellChatDB.use <- subsetDB(CellChatDB, search = c(‘Secreted Signaling’, ‘ECM-Receptor’, ‘Cell-Cell Contact’), key = c(‘annotation’)) 
##Preprocess phenotypic data for intercellular communication analysis
# set the used database in the object
cellchat@DB <- CellChatDB.use

# subset the expression data of signalling genes to save computational cost
cellchat <- subsetData(cellchat) # This step is necessary even when using the entire database

## Identify overexpressed ligands or receptors within each cell group to infer cell state-specific communication
options(future.globals.maxSize = 2 * 1024^3)  # Set to 2GB
future::plan(‘multisession’, workers = 4) # Perform in parallel

# Inspect the dimensions of the expression matrix
dim(cellchat@data.signaling)
# Check the length of cell labels
length(cellchat@meta$group_A)  # Replace with your actual grouping column name

  
  
cellchat <- identifyOverExpressedGenes(cellchat)
cellchat <- identifyOverExpressedInteractions(cellchat)
#> The number of highly variable ligand-receptor pairs used for signalling inference is 2467
ptm = Sys.time()
execution.time = Sys.time() - ptm
print(as.numeric(execution.time, units = ‘secs’))

# Project gene expression data onto PPI (Optional: when running it, USER should set `raw.use = FALSE` in the function `computeCommunProb()` in order to use the projected data)
# cellchat <- projectData(cellchat, PPI.human)

####Inferring Intercellular Communication Networks####
ptm = Sys.time()
cellchat <- computeCommunProb(cellchat, type = ‘triMean’)#type, i.e. the method for calculating the average gene expression of each cell group
cellchat <- filterCommunication(cellchat, min.cells = 10)


## Extract inferred cell communication network as data frame
# df.net <- subsetCommunication(cellchat) 
# May take considerable time
# cellchat <- computeCommunProb(cellchat, type = ‘triMean’, trim = NULL, raw.use = TRUE)
# cellchat <- filterCommunication(cellchat, min.cells = 5)
cellchat <- computeCommunProbPathway(cellchat)
cellchat@net
cellchat@netP


# Compute aggregated cell-cell communication network
cellchat <- aggregateNet(cellchat)
saveRDS(cellchat, file = ‘scRNA_NAR_cellchat_Net.rds’)




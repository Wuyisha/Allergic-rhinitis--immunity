library(patchwork)

CD4_Trm$Cell <- rownames(CD4_Trm@meta.data)

Ratio_Sample <- CD4_Trm@meta.data %>%
  select(Cell, group_A, Mφ_Proinflammatory1, Mφ_Immunoregulatory1) %>%
  mutate(group_A = factor(group_A, levels = c(‘NAR’, “SAR”, ‘MAR’)))

group.colour <- c(‘NAR’ = ‘#869C83’, ‘SAR’ = ‘#d8cd59’, “MAR” = ‘#eee934’)
comparisons.list <- list(c(‘NAR’, ‘MAR’), c(‘NAR’, ‘SAR’), c(“SAR”, ‘MAR’))

p.list <- lapply(c(‘Mφ_Proinflammatory1’, ‘Mφ_Immunoregulatory1’), function(var) {
  ggboxplot(Ratio_Sample, x = ‘group_A’, y = var,
            colour = ‘group_A’, legend = ‘none’,
            add = ‘jitter’, outlier.shape = NA) +
    scale_color_manual(values = group.color) +
    stat_compare_means(comparisons = comparisons.list, method = ‘wilcox.test’) +
    theme_minimal(base_size = 10) +
    theme(axis.text.x = element_text(angle = 45, hjust = 1))
})

final_plot <- wrap_plots(p.list, ncol = 2)   # You only have 2 plots, so ncol=2 suffices
print(final_plot)

# Save
ggsave(‘Macro_CCL3_Mφ_scores.pdf’, final_plot, width = 8, height = 4)





# Generate table of adjusted P-values
p_value_table <- lapply(c(‘Mφ_Proinflammatory1’, ‘Mφ_Immunoregulatory1’), function(var) {
  # Perform pairwise comparisons using pairwise.wilcox.test and adjust P-values
  p_test <- pairwise.wilcox.test(Ratio_Sample[[var]], Ratio_Sample$group_A, p.adjust.method = ‘BH’, paired = FALSE)  
  
  # Extract adjusted P-values  
  p_adj <- as.data.frame(p_test$p.value)
  
  # Add variable name column
  p_adj$Variable <- var
  
  return(p_adj)
})

# Combine adjusted P-values for all variables into a single table
p_value_table <- bind_rows(p_value_table)


# Print adjusted P-value table
print(p_value_table)



saveRDS(data_list, "raw_data_before_DoubletFinder.rds")
data_list <- readRDS('raw_data_before_DoubletFinder.rds')


for (i in 1:length(data_list)) {
  data_d <- data_list[[i]]
  sweep.res.list <- DoubletFinder::paramSweep_v3(data_d, PCs = 1:30, sct = FALSE)
  sweep.stats <- summarizeSweep(sweep.res.list, GT = FALSE)
  bcmvn <- find.pK(sweep.stats)
  mpK <- as.numeric(as.vector(bcmvn$pK[which.max(bcmvn$BCmetric)]))
  dim_data <- dim(data_d)
  nExp_poi <- round(0.02 * dim_data[2])  ## 3000~2.3%
  data_d <- doubletFinder_v3(data_d, PCs = 1:30, pN = 0.05, pK = mpK, nExp = nExp_poi, reuse.pANN = FALSE, sct = FALSE)
  assign(paste0("data_d", i), data_d)
  
  p <- paste("DF.classifications_", "0.05_", mpK, "_", nExp_poi, sep="")
  
  assign(paste0("D_p", i), p)
}




data_list <- list()
for (i in 1:list_length) {
  data_list[[i]] <- get(paste0("data_d", i))
}


for (i in 1:list_length) {

  data_f <- data_list[[i]]

  df_cols <- grep("DF.classifications", names(data_f@meta.data), value = TRUE)

  data_f$Doublet <- ifelse(data_f@meta.data[[df_cols[1]]] == "Doublet", "Doublet", "Singlet")
  data_f <- subset(data_f, subset = Doublet == "Singlet")
  
  assign(paste0("data_f", i), data_f)
}



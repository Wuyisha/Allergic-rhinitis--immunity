## CD4_Tcm
merged_data <- marker_data
colnames(merged_data)
# [1] "seqnames" "idx"      "name"     "Mean"     "FDR"      "Pval"    
# [7] "MeanDiff" "AUC"      "MeanBGD"  "group"  

to_remove <- grepl("^IG", merged_data$name) | 
  grepl("^HLA-", merged_data$name) | 
  grepl("^RPS", merged_data$name) | 
  grepl("^RPL", merged_data$name)

# 使用逻辑索引筛选数据框，删除标记的基因
merged_data <- merged_data[!to_remove, ]


colnames(merged_data)
# [1] "seqnames" "idx"      "name"     "Mean"     "FDR"      "Pval"    
# [7] "MeanDiff" "AUC"      "MeanBGD"  "group" 

unique(merged_data$group)
group_results <- list()
for (group_name in unique(merged_data$group)) {
  # group_name <- 'SAR'
  # group_name <- 'MAR'
  
  # 提取当前分组的数据
  group_data <- merged_data[merged_data$group == group_name, ]
  
  # 提取 logfoldchanges 最高和最低的 7 个基因
  topGenes <- group_data %>%
    top_n(18, FDR) %>%  # 最高的 7 个
    bind_rows(group_data %>% top_n(-18, FDR)) %>%  # 最低的 7 个
    pull(name)
  
  # 标记 Top-ranked 基因
  group_data$Topranked <- ifelse(group_data$name %in% topGenes, "Top-ranked", "Others")
  
  # 标记显著性
  group_data <- group_data %>%
    mutate(
      Significance = case_when(
        FDR < 0.05 & MeanDiff > 0.2 ~ "Up",
        FDR < 0.05 & MeanDiff < -0.2 ~ "Down",
        TRUE ~ "Others"
      )
    )
  
  # 计算 -log10(pvals_adj)
  group_data$pAdj.log <- -log10(group_data$FDR)
  
  #pdf("./TF_motif/scATAC_CD8_Trm_TFmotif_getmarkerfeature_Volcano.pdf", width = 4, height = 5)
  # 绘制火山图
  g <- ggplot(group_data, aes(x = MeanDiff, y = pAdj.log)) +
    geom_point_rast(aes(color = Significance)) +
    scale_color_manual(values = c("Up" = "#e83b2f", "Down" = "#3E5665", "Others" = "grey")) +#EAD256
    theme_classic(base_size = 12) +
    theme(
      legend.position = "bottom",
      axis.text = element_text(size = 10, color = "black"),
      axis.title = element_text(size = 12, color = "black")
    ) +
    geom_vline(xintercept = c(-0.1, 0.1), linetype = "dashed", color = "grey") +
    geom_text_repel(
      data = subset(group_data, Topranked == "Top-ranked"),
      aes(label = name),
      size = 4.6, fontface = "italic", color = "black",
      box.padding = unit(0.35, "lines"),
      point.padding = unit(0.3, "lines")
    ) +
    ggtitle(paste("Volcano Plot for", group_name)) +
    ylab("-Log10(Padj)")
  g
  
  # 保存图形
  ggsave(sprintf("./Motif/scATAC_CD4_Tcm_TFmotif_getmarkerfeature_meandiff_0.2_Volcano_%s.pdf", gsub(" ", "_", group_name)), plot = g, width = 4, height = 5)
  ggsave(sprintf("./Motif/scATAC_CD4_Tcm_TFmotif_getmarkerfeature_meandiff_0.2_Volcano_%s.png", gsub(" ", "_", group_name)), plot = g, width = 4, height = 5)
  
  # 将当前分组的结果存储到列表中
  group_results[[group_name]] <- group_data
}



# 获取 MAR 列前10个值对应的基因名（降序排列）
top_10_SAR <- enrich_CD4_Tcm_MOTIF %>% 
  arrange(desc(`MAR vs NAR (-Log10 (Padj))`)) %>%  # 按 MAR 列降序排列
  head(10) %>%  # 提取前10行
  rownames() %>%  # 提取对应的基因名
  as.character()  # 转换为字符向量

# 提取基因名的前部分（例如 "ATF2"、"BCL11A" 等）
extract_gene_name <- function(gene) {
  str_extract(gene, "[A-Za-z0-9]+(?=_)")  # 提取第一个下划线之前的部分
}

# 将所有基因名转换为简化格式
simplified_gene_names <- rownames(enrich_CD4_Tcm_MOTIF) %>% 
  sapply(extract_gene_name) %>% 
  as.character()

# 计算每个点的颜色强度（X轴数值 + Y轴数值）
enrich_CD4_Tcm_MOTIF$color_intensity <- 
  enrich_CD4_Tcm_MOTIF$`SAR vs NAR (-Log10 (Padj))` + 
  enrich_CD4_Tcm_MOTIF$`MAR vs NAR (-Log10 (Padj))`

# 绘制点图
ggplot(enrich_CD4_Tcm_MOTIF, aes(
  x = `SAR vs NAR (-Log10 (Padj))`, 
  y = `MAR vs NAR (-Log10 (Padj))`, 
  color = color_intensity  # 使用颜色强度映射颜色
)) +
  geom_point(alpha = 0.9) +  # 设置透明度
  scale_color_gradient(low = "#F69F99", high = "#bd1316") +  # 定义颜色渐变范围
  geom_text_repel(
    aes(label = ifelse(simplified_gene_names %in% sapply(top_10_SAR, extract_gene_name), simplified_gene_names, "")),
    box.padding = 0.35,  # 调整文本框的填充
    point.padding = 0.5,  # 调整文本与点的距离
    size = 5, 
    color = "#bd1316",
    segment.size = 0.7,  # 调整连线的粗细
    segment.color = "#bd1316",  # 调整连线的颜色
    arrow = arrow(length = unit(0.02, "npc")),  # 添加箭头
    direction = "y"  # 调整文本的方向
  ) +  # 只显示前10个基因名
  labs(title = "SAR and MAR TF Motif in CD4_Tcm", 
       x = "SAR vs NAR (-Log10 (Padj))", 
       y = "MAR vs NAR (-Log10 (Padj))") +  # 添加标题和轴标签
  theme_minimal() +  # 使用简洁的主题
  theme(
    plot.background = element_blank(),  # 去除背景
    panel.border = element_rect(color = "black", fill = NA, size = 1),  # 添加方框
    panel.grid.major = element_blank(),  # 去除网格线
    panel.grid.minor = element_blank(),
    panel.background = element_blank()  # 去除面板背景
  )

# 修改 ggplot 对象，去掉阴影（通常是 geom_ribbon 或类似图层）
library(ggplot2)

# 自定义函数：移除 geom_ribbon 层
remove_ribbon <- function(gg) {
  gg$layers <- gg$layers[sapply(gg$layers, function(x) !inherits(x$geom, "GeomRibbon"))]
  return(gg)
}

# 应用到每个 ggplot 对象
ggList_clean <- lapply(ggList, remove_ribbon)

# 绘图

plotBrowserTrackSingleGene <- function(ArchRProj, groupBy, geneSymbol, upstream, downstream,
                                       output_dir,
                                       addDOC = FALSE) {
  
  #无DAP
  p1 <- plotBrowserTrack(
    ArchRProj = ArchRProj, 
    groupBy = groupBy,
    geneSymbol = geneSymbol,
    pal = c("NAR" = "#a8a9cb", "SAR" = "#f3b669", "MAR" = "#f08c3c"),
    useGroups = c("NAR" , "SAR", "MAR"),
    baseSize = 7,#字体大小
    borderWidth = 1, 
    upstream = upstream,
    downstream = downstream
  )
  
  grid::grid.newpage()
  grid::grid.draw(p1[[geneSymbol]])
  
  plot_name <- paste0(output_dir, "/CD4_Tcm_", geneSymbol, "_groupby_", 
                      groupBy, "_Plot-Tracks-With-Features.pdf")
  plotPDF(p1, name = plot_name, width = 4, height = 5, 
          ArchRProj = ArchRProj, addDOC = addDOC)
}


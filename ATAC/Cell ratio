library(ArchR)
library(parallel)
library(Seurat)
library(pryr) 
library(dplyr)
addArchRThreads(threads = 16)
set.seed(1)
addArchRGenome("hg38")

setwd('/media/AnalysisTempDisk2/Wuyisha/HNM_IMMUNE/ArchR/Downstream/Cell_ratio')
proj <- loadArchRProject(path = "/media/AnalysisTempDisk2/Wuyisha/HNM_IMMUNE/ArchR/Immune_RNA_transfer/ArchRProject_23sample_RNA_transfer_T_B_MY_250819")


cellColData <- getCellColData(proj)
cell_col_data <- as.data.frame(cellColData)

Ratio_Sample <- cell_col_data %>%
  group_by(sample, celltype_L2) %>%
  summarise(n = n()) %>%
  mutate(relative_freq = n / sum(n))
print(Ratio_Sample)



Ratio_Sample$group_a <- factor(Ratio_Sample$group_a, levels = c("NAR", "SAR", "PAR"))
col <- c("NAR" = "#a8a9cb", "SAR" = "#f3b669", "PAR" = "#f08c3c")
his_cell_num <- Ratio_Sample %>%
  filter(group_a %in% c("NAR", "SAR", "PAR"))
my_comparisons <- list(c("NAR", "SAR"), c("SAR", "PAR"), c("NAR", "PAR"))
clusters <- unique(his_cell_num$celltype_L2)


############################ bar chart ############################
y_global <- range(his_cell_num$relative_freq, na.rm = TRUE)

make_violin <- function(cluster_data, cluster_name, show_y = FALSE) {
  ggplot(cluster_data,
         aes(x = group_a, y = relative_freq, colour = group_a)) +
    geom_violin(width = 0.8, scale = "width", alpha = 0.7) +
    geom_quasirandom(size = 1.5, width = 0.15, alpha = 0.8) +
    stat_compare_means(comparisons = my_comparisons,
                       label = "p.format", p.adjust.method = "fdr") +
    coord_cartesian(ylim = y_global) +
    scale_colour_manual(values = col) +
    theme_classic() +
    theme(
      axis.line.x  = element_line(),
      axis.line.y  = if (show_y) element_line() else element_blank(),
      axis.text.y  = if (show_y) element_text(size = 10) else element_blank(),
      axis.title.y = if (show_y) element_text(size = 12) else element_blank(),
      axis.text.x  = element_text(angle = 60, size = 10, hjust = 1, vjust = 1),
      axis.title.x = element_blank(),
      plot.title   = element_text(size = 10, hjust = 0.5),
      panel.spacing = unit(0, "lines"),
      strip.background = element_blank()
    ) +
    labs(title = cluster_name)
}


plots <- clusters %>%
  set_names() %>%
  map(~ his_cell_num %>% filter(celltype_L2 == .x)) %>%
  imap(~ make_violin(.x, .y, show_y = (.y == clusters[1])))


final_plot <- wrap_plots(plots, nrow = 1)

ggsave("scATAC_immune_sameY_1row.pdf", final_plot,
       width = length(clusters) * 2, height = 4, dpi = 300)
ggsave("scATAC_immune_sameY_1row.png", final_plot,
       width = length(clusters) * 2, height = 4, dpi = 300)





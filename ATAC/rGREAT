library(bedr)

allpeaks = read.csv("/media/AnalysisTempDisk2/Wuyisha/HNM_IMMUNE/ArchR/Downstream/TF_motif/T_cells/ArchRProject_23sample_peak_calling_T_group_A_CD8_Trm/CD8_Trm_peakSet.csv",head=T)
allpeaks = allpeaks[,c(1,2,3)]
allpeaks.loc = paste0(allpeaks[,1], ":", allpeaks[,2], "-", allpeaks[,3])
allpeaks.loc = bedr.sort.region(allpeaks.loc)
allpeaks$start <- as.integer(as.character(allpeaks$start))
allpeaks$end <- as.integer(as.character(allpeaks$end))

problematic_rows <- allpeaks[grep("e\\+", allpeaks$start), ]
print(problematic_rows)

celltypes <- c('PAR', 'SAR')

for(ct in celltypes){
  ct <- gsub("/", "_", ct)
  df <- read.csv(paste0("/media/AnalysisTempDisk2/Wuyisha/HNM_IMMUNE/ArchR/Downstream/TF_motif/T_cells/ArchRProject_23sample_peak_calling_T_group_A_CD8_Trm/dap_Trm_CD8_data_", ct, "_filter.csv"))
  
  df <- df %>% filter(Log2FC > 0.25)
  # do an overlap
  df.loc = paste0(df[,4], ":", df[,5], "-", df[,6])
  df.loc = bedr.sort.region(df.loc)
  df.intersect = bedr.join.region(df.loc,allpeaks.loc)
  
  df = unique(df.intersect[,2:4])
  colnames(df) = colnames(allpeaks)
  df = df[df$seqnames != ".",]
  df$start = as.numeric(df$start)
  df$end = as.numeric(df$end)
  problematic_rows <- df[grep("e\\+", df$start), ]
  print(problematic_rows)
  saveRDS(df, paste0("./DAP/celltype_special_peak/df.", ct, ".specific.rGREAT.out.rds"))

}




all_combined_data <- list()


for (celltype in celltypes) {
  input_file <- paste0("./DAP/celltype_special_peak/_Celltype.specific.peaks.", celltype, ".specific.rGREAT.out.rds")
  celltype_data <- readRDS(input_file)
  
  combined_data <- do.call(rbind, lapply(celltype_data, as.data.frame))
  
  combined_data$Celltype <- celltype
  
  output_file <- paste0("./DAP/rGREAT/rGREAT_", celltype, "_output.csv")
  write.csv(combined_data, output_file, row.names = FALSE)

  plot_data <- combined_data[, c("name", "Hyper_Fold_Enrichment", "Hyper_Adjp_BH", "Celltype")]
  plot_output_file <- paste0("./DAP/rGREAT/_rGREAT_", celltype, "_output_Plot.csv")
  write.csv(plot_data, plot_output_file, row.names = FALSE)

  all_combined_data[[celltype]] <- plot_data
}



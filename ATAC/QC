####QC####====================================================================
cellColData <- getCellColData(proj, select = c("Sample","BioNames", "nFrags",'TSSEnrichment', "ReadsInBlacklist", "NucleosomeRatio"))
sampleData <- as.data.frame(cellColData)


data_list <- list()

for (library in librarys) {
  sample_data <- subset(sampleData, Sample == library)
  id <- unique(sample_data$Sample)
  print(id)
  
  nCount_peaks_quantiles <- quantile(sample_data$nFrags, c(0.05, 0.95), na.rm = TRUE)
  nucleosome_signal_quantiles <- quantile(sample_data$NucleosomeRatio, c(0.95), na.rm = TRUE)
  TSS.enrichment_quantiles <- quantile(sample_data$TSSEnrichment, c(0.1), na.rm = TRUE)
  blacklist_ratio_quantiles <- quantile(sample_data$ReadsInBlacklist, c(0.95), na.rm = TRUE)
  
  # QC
  data_filtered <- subset(sample_data, 
                          nFrags < nCount_peaks_quantiles[2] & 
                            NucleosomeRatio < nucleosome_signal_quantiles[1] &
                            TSSEnrichment < 25 & 
                            ReadsInBlacklist < blacklist_ratio_quantiles[1])

  data_list[[library]] <- data_filtered
}



filter_data_all <- data.frame()
for (library in names(data_list)) {
  filter_data_all <- rbind(filter_data_all, data_list[[library]])
}
print(filter_data_all)


cell_names <- rownames(filter_data_all)
subset_indices <- proj$cellNames %in% cell_names
proj1 <- proj[subset_indices, ]
max_ess <- max(proj1$TSSEnrichment, na.rm = TRUE)
print(max_ess)


proj2 <- filterDoublets(proj1, filterRatio = 2)
saveArchRProject(ArchRProj = proj2, 
                 outputDirectory = "ArchRProject_23sample_QC", 
                 load = FALSE)

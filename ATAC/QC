inputdir="/media/RawData/14.NasalMucosa/ATAC/V2/"
file_names <- list.files(inputdir, full.names = TRUE)
file_names <- basename(file_names)  
sample_names <- grep("HNM", file_names, value = TRUE)


FragmentFiles <- list()
validBarcodesList <- list()
ArrowFiles <- list()  

for (sample_name in sample_names) {
  first_name <- list.files(paste0(inputdir, '/', sample_name, "/"), pattern = "\\.tsv\\.gz$")
  first_name <- first_name[1]  
  file_paths <- paste0(inputdir, '/', sample_name, "/", first_name)
  FragmentFiles[[sample_name]] <- file_paths
  
  metadata_path <- paste0(inputdir, '/', sample_name, "/singlecell.csv")
  metadata <- read.csv(metadata_path, header = TRUE, row.names = 1)
  validBarcodes <- rownames(metadata[metadata$is_cell_barcode == 1, ])
  validBarcodesList[[sample_name]] <- validBarcodes
  
  arrow_file <- createArrowFiles(
    inputFiles = FragmentFiles[[sample_name]],
    sampleNames = sample_name,  #
    minFrags = 1000, 
    minTSS = 4,
    addTileMat = TRUE,
    addGeneScoreMat = TRUE,
    threads = 16,
    validBarcodes = validBarcodesList[[sample_name]],
    force = TRUE  # 
  )
  

  ArrowFiles[[sample_name]] <- arrow_file
}
print(ArrowFiles)


ArrowFiles_chr <- unlist(ArrowFiles)
doubScores <- addDoubletScores(
  input = ArrowFiles_chr,
  k = 10, # 
  knnMethod = "UMAP",
